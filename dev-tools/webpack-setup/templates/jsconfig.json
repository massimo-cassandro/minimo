{
  "__help": "https://code.visualstudio.com/docs/languages/jsconfig",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "allowSyntheticDefaultImports": false,

    "target": "es2023",
    "module": "ES6",
    "paths": {
      "@css/*": ["./frontend/src/css/*"],
      "@src/*": ["./frontend/src/*"],
      "@icons/*": ["./frontend/icons/*"],
      "@imgs/*": ["./frontend/imgs/*"],
      "@frontend/*": ["./frontend/*"],
      "@minimo/*": ["./node_modules/@massimo-cassandro/minimo/src/*"],
      "@minimoCharts/*": ["./node_modules/@massimo-cassandro/minimo/charts/*"]
    }
  },
  "exclude": ["node_modules", "dist", "docs", "build", "public"]
}
