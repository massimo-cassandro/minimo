# Nega l'accesso diretto ai soli file di configurazione (contengono le
# credenziali OAuth). Gli altri file di questa cartella sono endpoint veri
# e propri (login.php, callback.php, whoami.php, ecc.) e devono restare
# raggiungibili normalmente: qui non c'è un "Require all denied" sull'intera
# cartella come quando cfg/ era isolata.
# I file restano comunque leggibili da PHP tramite require (accesso da
# filesystem, non passa da Apache), quindi l'app continua a funzionare.

<FilesMatch "^config(-template|-prod)?\.php$">
    # Apache 2.4+ (praticamente tutti gli hosting attuali)
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>

    # Fallback per Apache 2.2 (hosting più vecchi)
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
