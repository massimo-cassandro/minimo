<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <title>{%- block title -%}{%- endblock %} | xxxxx</title>
    <meta name="robots" content="noindex, nofollow, noarchive">
    {%- include '_incl/favicons.incl.html.twig'-%}
    {{- '' -}}
    {#- shared.js, runtime.js e shared.css servono solo con `useSharedChunk: true` in webpack.config.mjs:
        con `false` rimuovere tutte le righe che li referenziano (qui sotto e a fine body) -#}
    <link rel="preload" href="{{ asset('index.js') }}" as="script">
    <link rel="preload" href="{{ asset('shared.js') }}" as="script">
    <link rel="preload" href="{{ asset('runtime.js') }}" as="script">
    {{- '' -}}
    <link rel="preload" href="{{ asset('shared.css') }}" as="style">
    <link rel="preload" href="{{ asset('index.css') }}" as="style">
    {# shared.css va inserito PRIMA del css della entry (ordine della cascata) #}
    <link rel="stylesheet" href="{{ asset('shared.css') }}" type="text/css" media="all">
    <link rel="stylesheet" href="{{ asset('index.css') }}" type="text/css" media="all">
    <style>
      {%- include '@public_path' ~ asset('layout.critical.css') -%}
    </style>
    {%- block head -%}{%- endblock -%}
  </head>
  <body>

    {%- block body -%}{%- endblock -%}

    <script src="{{ asset('runtime.js') }}"></script>
    <script src="{{ asset('shared.js') }}"></script>
    <script src="{{ asset('index.js') }}"></script>
    {%- block js -%}{%- endblock -%}
  </body>
</html>
