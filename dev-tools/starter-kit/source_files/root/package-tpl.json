{
  "name": "xxxxx",
  "description": "",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Massimo Cassandro",
  "main": "index.js",
  "type":"module",
  "sideEffects": [
    "*.css",
    "*.js",
    "*.svg",
    "*.jpg",
    "*.jpeg",
    "*.png",
    "*.webp",
    "*.avif"
  ],
  "scripts": {
    "progetto JS webpack DEV": "NODE_ENV=development webpack serve --config ./webpack.config.mjs #--open-app-name 'Google Chrome'",
    "php server": "php -S localhost:[[port8000]] # -t root_dir/",
    "progetto sf webpack DEV": "rm -rf ./public/_dev && NODE_ENV=development webpack serve --config ./webpack.config.mjs # http://192.168.1.135:[[port5700]",
    "symfony server": "symfony serve --port=[[port8000]] --listen-ip=0.0.0.0 # http://192.168.1.135:[[port8000]] # -d (deamon): rimane aperto anche dopo la chiusura del terminale, terminare con `symfony server:stop`",
    "webpack PROD": "npm run 'UPD-version' && NODE_ENV=production webpack --config ./webpack.config.mjs --stats minimal",
    "email sass": "npx sass ./app/email:./templates/email/css --no-source-map --style=compressed --watch",
    "postcss email": "postcss ./app/email/[!_]*.css --dir ./templates/email/css --no-map --verbose --config ./app/email --watch",
    "eslint-check": "npx eslint app/",
    "stylelint-check": "npx stylelint 'app/**/*.css'",
    "create-favicons INIT": "npx create-favicons init",
    "create-favicons": "npx create-favicons --dir=./app/favicons",
    "UPD-version": "npx update-version --no-log-v0 --log-file=./changelog.md # --log-patch --pkg=alt/path/to/package.json",
    "upd@m": "npx upd@m",
    "launchChrome": "open -n -a 'Google Chrome' --args --profile-directory='Profile 3' # mbn: 1 / mg2: 3",
    "python server": "python3 -m http.server [[port8000]] # --directory __dirname__ # 8000 = default port",
    "node server": "node serve # richiede ‘npm i serve’",
    "build tokens": "npx buildTokens --config ./app/css/tokens-config.mjs",
    "check unresolved props": "npx checkUnresolvedProps --config ./app/css/tokens-config.mjs",
    "npm-outdated": "npm outdated",
    "npm-upd": "npm update --save"
  },
  "devDependencies": {},
  "dependencies": {}
}
