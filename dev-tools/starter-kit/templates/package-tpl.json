{
  "name": "xxxxx",
  "description": "",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Massimo Cassandro",
  "main": "index.js",
  "type":"module",
  "sideEffects": [
    "*.css",
    "*.js",
    "*.svg",
    "*.jpg",
    "*.jpeg",
    "*.png",
    "*.webp",
    "*.avif"
  ],
  "scripts": {
    "progetto JS webpack DEV": "npm 'launchChrome' && NODE_ENV=development webpack serve --config ./webpack.config.mjs #--open-app-name 'Google Chrome'",
    "progetto sf webpack DEV": "rm -rf ./public/_dev && NODE_ENV=development webpack --config ./frontend/webpack.config.mjs",
    "webpack PROD": "npm run 'UPD-version' && NODE_ENV=production webpack --config ./webpack.config.mjs --stats minimal",
    "eslint-check": "npx eslint app/ # or src/, frontend/src/ ...",
    "create-favicons INIT": "npx create-favicons init",
    "create-favicons": "npx create-favicons --dir=./favicons # o ./frontend/favicons",
    "UPD-version": "npx update-version --noLogv0 # --log-file=./frontend/changelog.md --log-patch --pkg=alt/path/to/package.json",
    "upd@m": "npx upd@m",
    "launchChrome": "open -n -a 'Google Chrome' --args --profile-directory='Profile 3'",
    "python server": "python3 -m http.server 8000 # --directory __dirname__ # 8000 = default port",
    "php server": "php -S localhost:8000 # -t root_dir/",
    "symfony server": "symfony serve --port=810X --listen-ip=0.0.0.0 # http://192.168.1.135:810X # -d (deamon): rimane aperto anche dopo la chiusura del terminale, terminare con `symfony server:stop`",
    "node server": "node serve # richiede ‘npm i serve’",
    "build tokens": "npx buildTokens --config ./src/css/tokens-config.mjs # o ./frontend/src/css/tokens-config.mjs",
    "check unresolved props": "npx checkUnresolvedProps --config ./src/css/tokens-config.mjs # o ./frontend/src/css/tokens-config.mjs",
    "npm-outdated": "npm outdated",
    "npm-upd": "npm update --save"
  },
  "devDependencies": {},
  "dependencies": {}
}
