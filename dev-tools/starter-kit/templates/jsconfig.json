{
  "__help": "https://code.visualstudio.com/docs/languages/jsconfig",
  "__note": "Tenere questo file ACCANTO a webpack.config.mjs: gli alias webpack sono ricavati da qui (get-jsConfig-aliases.mjs) e risolti a partire dalla posizione di questo file",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "allowSyntheticDefaultImports": false,

    "target": "es2023",
    "module": "ES6",
    "paths": {
      "@css/*": ["./src/css/*"],
      "@src/*": ["./src/*"],
      "@icons/*": ["./icons/*"],
      "@imgs/*": ["./imgs/*"],
      "@frontend/*": ["./*"],
      "@minimo/*": ["__NODE_MODULES__/@massimo-cassandro/minimo/src/*"],
      "@minimoCharts/*": ["__NODE_MODULES__/@massimo-cassandro/minimo/charts/*"]
    }
  },
  "exclude": ["__NODE_MODULES__", "dist", "docs", "build", "public"]
}
