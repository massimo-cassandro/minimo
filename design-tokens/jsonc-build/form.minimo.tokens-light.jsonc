// -----------------------------------------------------------------------
{
  "form": {
    "label": {
      "font": {
        "size": {
          "$type": "dimension",
          "$value": "{font.size.sm}"
        },
        "weight": {
          "$type": "fontWeight",
          "$value": "{font.weight.semibold}"
        }
      },
      "color": {
        "$type": "color",
        "$value": "{text.color}"
      }
    },
    "group": {
