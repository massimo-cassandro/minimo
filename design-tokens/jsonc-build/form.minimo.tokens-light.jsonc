        "$type": "dimension",
        "$value": "0 {size.base}"
      }
    },
    "input-group": {
      "background": {
        "color": {
          "$type": "color",
          "$value": "transparent"
        }
      }
    },
    "control": {
      "static": {
        "color": {
          "$type": "color",
          "$value": "{form.control.text.color}"
        },
        "background": {
          "color": {
            "$type": "color",
            "$value": "transparent"
          }
        }
      },
      "text": {
        "color": {
          "$type": "color",
          "$value": "{text.color}"
        }
      },
      "font": {
        "style": {
          "$type": "string",
          "$value": "normal"
        },
        "weight": {
          "$type": "fontWeight",
          "$value": "{font.weight.regular}"
        },
        "size": {
          "$type": "dimension",
          "$value": "{font.size.base}"
        }
      },
      "background": {
        "color": {
          "$type": "color",
          "$value": "{body.background.color}"
        }
      },
      "line-height": {
        "$type": "number",
        "$value": "1.2"
      },
      "padding": {
        "inline": {
          "$type": "dimension",
          "$value": "{size.sm}"
        },
        "block": {
          "$type": "dimension",
          "$value": "{size.xs}"
        }
      },
      "border": {
        "color": {
          "$type": "color",
          "$value": "#666"
        },
        "width": {
          "$type": "dimension",
          "$value": "1px"
        },
        "style": {
          "$type": "string",
          "$value": "solid"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{radius.xxs}"
        }
      },
      "placeholder": {
        "color": {
          "$type": "color",
          "$value": "#666"
        },
        "opacity": {
          "$type": "number",
          "$value": 0.8
        },
        "font": {
          "size": {
            "$type": "dimension",
            "$value": "{form.control.font.size}"
          },
          "style": {
            "$type": "string",
            "$value": "italic"
          }
        }
      },
      "disabled": {
        "background": {
          "color": {
            "$type": "color",
            "$value": "#ddd"
          }
        },
        "color": {
          "$type": "color",
          "$value": "#999"
        },
        "opacity": {
          "$type": "number",
          "$value": 0.7
        },
        "font": {
          "style": {
            "$type": "string",
            "$value": "italic"
          }
        }
      },
      "readonly": {
        "background": {
          "color": {
            "$type": "color",
            "$value": "{form.control.background.color}"
          }
        },
        "color": {
          "$type": "color",
          "$value": "#666"
        },
        "opacity": {
          "$type": "number",
          "$value": 1
        },
        "font": {
          "style": {
            "$type": "string",
            "$value": "italic"
          }
        }
      },
      "required": {
