// -----------------------------------------------------------------------
// File generato — non modificare a mano.
// Questo file è prodotto dalla pipeline di build dei design token.
// Fonte di verità: i file dei token nella directory sorgente del progetto.
// Per rigenerarlo: node build-tokens.mjs --config <path/to/config>
// -----------------------------------------------------------------------
{
  "sdt": {
    "thead": {
      "hover": {
        "background": {
          "color": {
            "$type": "color",
            "$value": "color-mix(in srgb, {table.thead.background.color} 90%, {accent})"
          }
        }
      }
    },
    "pagination": {
      "border": {
        "$type": "border",
        "$value": {
          "color": "#666",
          "width": "1px"
        }
      },
      "padding": {
        "block": {
          "$type": "dimension",
          "$value": "{size.xxs}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{size.xs}"
        }
      }
    },
    "hover": {
      "background": {
        "color": {
          "$type": "color",
          "$value": "{btn.primary.background.color}"
        }
      },
      "color": {
        "$type": "color",
        "$value": "{btn.primary.color}"
      }
    }
  }
}
